# --- Embeddings (ajustar según el modelo que uses) ---
# 384  = all-MiniLM-L6-v2 (gratis, rápido)
# 768  = multilingual-e5-base (multilingüe)
# 1536 = OpenAI text-embedding-ada-002
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=text-embedding-ada-002
